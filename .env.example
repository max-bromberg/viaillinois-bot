# ── Discord ──────────────────────────────────────────────────────────────────
# From the Discord developer portal, for the development application when
# running locally and for the production application when deployed.
DISCORD_TOKEN=
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# ── Web platform ─────────────────────────────────────────────────────────────
# The internal service API the web platform serves on the private container
# network. In the deployed stack this is http://via:3001. BOT_SERVICE_TOKEN is
# the same long random secret the web platform holds: openssl rand -hex 32
VIA_INTERNAL_URL=http://localhost:3001
BOT_SERVICE_TOKEN=change_me_in_production

# ── Database ─────────────────────────────────────────────────────────────────
# The bot's own database inside the MySQL container the web platform already
# runs, with its own account that cannot see the web platform's database.
DB_HOST=localhost
DB_PORT=3306
BOT_DB_USER=via_bot
BOT_DB_PASSWORD=changeme
BOT_DB_NAME=via_bot

# The migrate script needs more than the application account has, so it uses
# these when set and falls back to root with BOT_DB_PASSWORD otherwise, which
# is how the database container is provisioned.
# BOT_DB_ADMIN_USER=root
# BOT_DB_ADMIN_PASSWORD=

# ── Health ───────────────────────────────────────────────────────────────────
# The one port the bot exposes, for GET /health, which the cutover gates on.
HEALTH_PORT=3002

# ── Tests ────────────────────────────────────────────────────────────────────
# Host port of the throwaway test database. Only the test support reads this.
# BOT_TEST_DB_PORT=3308
